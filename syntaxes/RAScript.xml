            <WordsStyle name="DARK-HEADER-ID-KEY" styleID="30" fgColor="569CD6" />

            <!-- styleIDs 32-39 are reserved by Scintilla, do not use -->
            <WordsStyle name="LIGHT-HEADER-ID-VALUE" styleID="40" fgColor="096D48" />
            <WordsStyle name="DARK-HEADER-ID-VALUE" styleID="41" fgColor="B5CEA8" />

            <WordsStyle name="LIGHT-HEADER-MINIMUMVERSION-KEY" styleID="42" fgColor="0F4A85" />
            <WordsStyle name="DARK-HEADER-MINIMUMVERSION-KEY" styleID="43" fgColor="569CD6" />

            <WordsStyle name="LIGHT-HEADER-MINIMUMVERSION-VALUE" styleID="44" fgColor="096D48" />
            <WordsStyle name="DARK-HEADER-MINIMUMVERSION-VALUE" styleID="45" fgColor="B5CEA8" />

            <WordsStyle name="LIGHT-STRING-PLACEHOLDER" styleID="46" fgColor="0F4A85" />
            <WordsStyle name="DARK-STRING-PLACEHOLDER" styleID="47" fgColor="569CD6" />

            <WordsStyle name="LIGHT-STRING-ESCAPE" styleID="48" fgColor="EE0000" />
            <WordsStyle name="DARK-STRING-ESCAPE" styleID="49" fgColor="D7BA7D" />

            <WordsStyle name="LIGHT-VARIABLE-ASSIGNMENT" styleID="50" fgColor="001080" />
            <WordsStyle name="DARK-VARIABLE-ASSIGNMENT" styleID="51" fgColor="9CDCFE" />

            <WordsStyle name="LIGHT-PARAMETERS" styleID="52" fgColor="001080" />
            <WordsStyle name="DARK-PARAMETERS" styleID="53" fgColor="9CDCFE" />

            <WordsStyle name="LIGHT-BUILTIN-FUNCTIONS" styleID="54" fgColor="5E2CBC" />
            <WordsStyle name="DARK-BUILTIN-FUNCTIONS" styleID="55" fgColor="DCDCAA" />

            <WordsStyle name="LIGHT-NAMED-ARGUMENTS" styleID="56" fgColor="001080" />
            <WordsStyle name="DARK-NAMED-ARGUMENTS" styleID="57" fgColor="9CDCFE" />
        </LexerType>
    </LexerStyles>
    <RAScript version="_GRAMMAR_VERSION_">
        <Include ref="#statements" />
        <Repository>
            <Rule name="statements">
                <!-- header before comments, since both start with // -->
                <Include ref="#header" />
                <Include ref="#comments" />
                <Include ref="#controls" />
                <Include ref="#function-definitions" />
                <Include ref="#booleans" />
                <Include ref="#strings" />
                <Include ref="#numbers" />
                <Include ref="#function-names" />
                <Include ref="#class-definitions" />
                <Include ref="#lambdas" />
                <Include ref="#parentheses" />
                <Include ref="#blocks" />
                <Include ref="#brackets" />
                <Include ref="#variable-language-this" />
                <Include ref="#variable-assignment" />
                <Include ref="#variable-other" />
            </Rule>
            <Rule name="header">
                <Rule match="^//[\t ]*(#ID)[\t ]*=[\t ]*(\d+)$" lightStyle="25" darkStyle="26">
                    <Capture index="1" lightStyle="29" darkStyle="30" />
                    <Capture index="2" lightStyle="40" darkStyle="41" />
                </Rule>
                <!-- only the RATools release versions listed in https://github.com/Jamiras/RATools/blob/master/Source/Data/Version.cs (0.73-0.79, 1.0-1.4, 1.3.1, 1.4.1, 1.4.2), optionally padded with .0 up to the 4 parts RATools parses (1.0.0.0 is 1.0). -->
                <Rule match="^//[\t ]*(#MinimumVersion)[\t ]*=[\t ]*((?:0\.7[3-9]|1\.[0-4])(?:\.0){0,2}|(?:1\.3\.1|1\.4\.[12])(?:\.0)?)$" lightStyle="25" darkStyle="26">
                    <Capture index="1" lightStyle="42" darkStyle="43" />
                    <Capture index="2" lightStyle="44" darkStyle="45" />
                </Rule>
            </Rule>
            <Rule name="comments">
                <Rule begin="/\*" end="\*/" lightStyle="27" darkStyle="28">
                    <Capture index="0" lightStyle="27" darkStyle="28" />
                </Rule>
                <Rule begin="//" end="$" lightStyle="25" darkStyle="26">
                    <BeginCapture index="0" lightStyle="25" darkStyle="26" />
                </Rule>
            </Rule>
            <Rule name="strings">
                <Rule begin='"' end='"' lightStyle="23" darkStyle="24">
                    <Rule match="\\u[0-9a-fA-F]{4}" lightStyle="48" darkStyle="49" />
                    <Rule match="\\." lightStyle="48" darkStyle="49" />
                    <Rule match="({)([0-9]+)(})">
                        <Capture index="1" lightStyle="46" darkStyle="47" />
                        <Capture index="2" lightStyle="1" darkStyle="2" />
                        <Capture index="3" lightStyle="46" darkStyle="47" />
                    </Rule>
                </Rule>
            </Rule>
            <Rule name="controls">
                <!-- if with its condition in parentheses: the condition is its own region so if (x) { isn't read as the lambda (x) { ... } -->
                <Rule begin="\b(if)[\t ]*\(" end="\)">
                    <BeginCapture index="1" lightStyle="3" darkStyle="4" />
                    <Include ref="$self" />
                </Rule>
                <!-- for loop header: in is only a keyword after for and the loop variable, elsewhere it is a normal name (in = 1, function in(...)) -->
                <Rule match="\b(for)[\t ]+(\b(?!\d)\w+)[\t ]+(in)\b">
                    <Capture index="1" lightStyle="3" darkStyle="4" />
                    <Capture index="2" lightStyle="1" darkStyle="2" />
                    <Capture index="3" lightStyle="3" darkStyle="4" />
                </Rule>
                <Rule match="\b(if|else|for|return)\b" lightStyle="3" darkStyle="4" />
            </Rule>
            <!-- a function definition from the function keyword to the ) closing its parameter list, so parameters can span lines. The keyword, name and ( must be on the same line -->
            <Rule name="function-definitions" begin="(\bfunction\b)\s*(\w+)\s*\(" end="\)">
                <BeginCapture index="1" lightStyle="17" darkStyle="18" />
                <BeginCapture index="2" lightStyle="21" darkStyle="22" />
                <Include ref="#comments" />
                <!-- default value: everything after = up to the next , or ) is highlighted as usual. Parentheses, blocks and brackets in the value consume their own , and ) -->
                <Rule begin="=(?!=)" end="(?=[,)])">
                    <Include ref="$self" />
                </Rule>
                <!-- parameter name -->
                <Rule match="\b(?!\d)\w+" lightStyle="52" darkStyle="53" />
            </Rule>
            <Rule name="function-names">
                <!-- a function call from its name to the closing ), so arguments can span lines. Named arguments (title = ...) are scoped as parameters of the call. This rule is for built-ins; a built-in name after a . is a method call (this.prev()), left to the next rule -->
                <Rule begin="(?&lt;!\.)\b(byte|word|tbyte|dword|bit0|bit1|bit2|bit3|bit4|bit5|bit6|bit7|bit|low4|high4|bitcount|word_be|tbyte_be|dword_be|float|float_be|mbf32|mbf32_le|double32|double32_be|prev|prior|bcd|identity_transform|ascii_string_equals|unicode_string_equals|remembered|repeated|once|tally|deduct|never|unless|measured|trigger_when|disable_when|always_true|always_false|format|substring|length|range|array_push|array_pop|array_map|array_contains|array_reduce|array_filter|field_map|dictionary_contains_key|any_of|all_of|none_of|sum_of|tally_of|max_of|assert|achievement|achievement_set|rich_presence_display|rich_presence_value|rich_presence_lookup|rich_presence_ascii_string_lookup|rich_presence_macro|rich_presence_conditional_display|leaderboard|__ornext)\b\s*\(" end="\)">
                    <BeginCapture index="1" lightStyle="54" darkStyle="55" />
                    <Include ref="#call-arguments" />
                </Rule>
                <!-- a call to any other function, including methods named like built-ins (this.prev()). A separate rule from the built-ins, so neither needs to exclude the other -->
                <Rule begin="\b(\w+)\s*\(" end="\)">
                    <BeginCapture index="1" lightStyle="19" darkStyle="20" />
                    <Include ref="#call-arguments" />
                </Rule>
                <!-- any other name at the end of a line, built-ins included, which is a call if its ( is on a later line. The grammar can't see the next line when the name is scoped, so the name stays a variable, but the arguments are scoped as a call's. Reserved words are left to their own rules (return (x), this) -->
                <Rule begin="\b(?!(?:if|else|for|in|return|function|class|this|true|false)\b)((?!\d)\w+)\b(?=[\t ]*(?://.*)?$)" end="(?=[^\s(/])">
                    <BeginCapture index="1" lightStyle="1" darkStyle="2" />
                    <Include ref="#comments" />
                    <Rule begin="\(" end="\)">
                        <Include ref="#call-arguments" />
                    </Rule>
                </Rule>
            </Rule>
            <!-- the inside of a function call's parentheses -->
            <Rule name="call-arguments">
                <!-- named argument: the name in name = value, but not in name == value or the lambda name => value -->
                <Rule match="\b(?!\d)\w+(?=[\t ]*=(?![=>]))" lightStyle="56" darkStyle="57" />
                <Include ref="$self" />
            </Rule>
            <Rule name="lambdas">
                <!-- lambda with parameters in parentheses: (a, b) => ... or (a, b) { ... }. The ( and the names up to ) => or ) { must be on one line -->
                <Rule begin="\((?=(?:\w|[\t ,])*\)[\t ]*(?:=>|\{))" end="\)">
                    <Rule match="\b(?!\d)\w+" lightStyle="52" darkStyle="53" />
                </Rule>
                <!-- lambda with one parameter and no parentheses: v => ... -->
                <Rule match="\b(?!\d)\w+(?=[\t ]*=>)" lightStyle="52" darkStyle="53" />
            </Rule>
            <!-- matched ( ) pairs, so a region containing them can't end on their ) or on a , inside them. The contents are highlighted as usual -->
            <Rule name="parentheses" begin="\(" end="\)">
                <Include ref="$self" />
            </Rule>
            <!-- matched { } pairs, so a region containing them can't end on a ) or , inside them. The contents are highlighted as usual -->
            <Rule name="blocks" begin="\{" end="\}">
                <Include ref="$self" />
            </Rule>
            <!-- matched [ ] pairs, so a region containing them can't end on a ) or , inside them. The contents are highlighted as usual -->
            <Rule name="brackets" begin="\[" end="\]">
                <Include ref="$self" />
            </Rule>
            <Rule name="booleans" match="\b(?:true|false)\b" lightStyle="7" darkStyle="8" />
            <Rule name="numbers">
                <!-- whole numbers and decimals like 19.25, scoped as one number including the dot -->
                <Rule match="\b[0-9]+(\.[0-9]+)?\b" lightStyle="9" darkStyle="10" />
                <Rule match="\b0x[0-9a-fA-F]+\b" lightStyle="11" darkStyle="12" />
            </Rule>
            <Rule name="class-definitions" match="(\bclass\b)[\t ]*(\b(?!\d)\w+)">
                <Capture index="1" lightStyle="13" darkStyle="14" />
                <Capture index="2" lightStyle="15" darkStyle="16" />
            </Rule>
            <Rule name="variable-language-this" match="\bthis\b" lightStyle="5" darkStyle="6" />
            <!-- left hand side of variable assignment, but not of an == comparison -->
            <Rule name="variable-assignment" match="\b(?!\d)\w+(?=[\t ]*=(?!=))" lightStyle="50" darkStyle="51" />
            <!-- different variables around the file being used, not assignment -->
            <Rule name="variable-other" match="\b(?!\d)\w+" lightStyle="1" darkStyle="2" />
        </Repository>
    </RAScript>
</NotepadPlus>