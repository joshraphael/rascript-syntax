<NotepadPlus version="2">
    <Languages>
        <Language name="RAScript" ext="rascript" commentLine="" commentStart="" commentEnd="">
        </Language>
    </Languages>
    <LexerStyles>
        <LexerType name="RAScript" desc="RAScript file" ext="" excluded="no">
            <WordsStyle name="LIGHT-VARIABLES" styleID="1" fgColor="001080" />
            <WordsStyle name="DARK-VARIABLES" styleID="2" fgColor="9CDCFE" />

            <WordsStyle name="LIGHT-CONTROL" styleID="3" fgColor="B5200D" />
            <WordsStyle name="DARK-CONTROL" styleID="4" fgColor="C586C0" />

            <WordsStyle name="LIGHT-THIS" styleID="5" fgColor="0F4A85" />
            <WordsStyle name="DARK-THIS" styleID="6" fgColor="569CD6" />

            <WordsStyle name="LIGHT-BOOLEANS" styleID="7" fgColor="0F4A85" />
            <WordsStyle name="DARK-BOOLEANS" styleID="8" fgColor="569CD6" />

            <WordsStyle name="LIGHT-DECIMALS" styleID="9" fgColor="096D48" />
            <WordsStyle name="DARK-DECIMALS" styleID="10" fgColor="B5CEA8" />

            <WordsStyle name="LIGHT-HEXADECIMALS" styleID="11" fgColor="096D48" />
            <WordsStyle name="DARK-HEXADECIMALS" styleID="12" fgColor="B5CEA8" />

            <WordsStyle name="LIGHT-CLASS" styleID="13" fgColor="0F4A85" />
            <WordsStyle name="DARK-CLASS" styleID="14" fgColor="569CD6" />

            <WordsStyle name="LIGHT-CLASS-NAME" styleID="15" fgColor="185E73" />
            <WordsStyle name="DARK-CLASS-NAME" styleID="16" fgColor="4EC9B0" />

            <WordsStyle name="LIGHT-FUNCTION" styleID="17" fgColor="0F4A85" />
            <WordsStyle name="DARK-FUNCTION" styleID="18" fgColor="569CD6" />

            <WordsStyle name="LIGHT-FUNCTION-CALLS" styleID="19" fgColor="5E2CBC" />
            <WordsStyle name="DARK-FUNCTION-CALLS" styleID="20" fgColor="DCDCAA" />

            <WordsStyle name="LIGHT-FUNCTION-NAME" styleID="21" fgColor="5E2CBC" />
            <WordsStyle name="DARK-FUNCTION-NAME" styleID="22" fgColor="DCDCAA" />

            <WordsStyle name="LIGHT-STRINGS" styleID="23" fgColor="0F4A85" />
            <WordsStyle name="DARK-STRINGS" styleID="24" fgColor="CE9178" />

            <WordsStyle name="LIGHT-LINE-COMMENTS" styleID="25" fgColor="515151" />
            <WordsStyle name="DARK-LINE-COMMENTS" styleID="26" fgColor="6A9955" />

            <WordsStyle name="LIGHT-BLOCK-COMMENTS" styleID="27" fgColor="515151" />
            <WordsStyle name="DARK-BLOCK-COMMENTS" styleID="28" fgColor="6A9955" />

            <WordsStyle name="LIGHT-HEADER-ID-KEY" styleID="29" fgColor="0F4A85" />
            <WordsStyle name="DARK-HEADER-ID-KEY" styleID="30" fgColor="569CD6" />

            <!-- styleIDs 32-39 are reserved by Scintilla, do not use -->
            <WordsStyle name="LIGHT-HEADER-ID-VALUE" styleID="40" fgColor="096D48" />
            <WordsStyle name="DARK-HEADER-ID-VALUE" styleID="41" fgColor="B5CEA8" />

            <WordsStyle name="LIGHT-HEADER-MINIMUMVERSION-KEY" styleID="42" fgColor="0F4A85" />
            <WordsStyle name="DARK-HEADER-MINIMUMVERSION-KEY" styleID="43" fgColor="569CD6" />

            <WordsStyle name="LIGHT-HEADER-MINIMUMVERSION-VALUE" styleID="44" fgColor="096D48" />
            <WordsStyle name="DARK-HEADER-MINIMUMVERSION-VALUE" styleID="45" fgColor="B5CEA8" />

            <WordsStyle name="LIGHT-STRING-PLACEHOLDER" styleID="46" fgColor="0F4A85" />
            <WordsStyle name="DARK-STRING-PLACEHOLDER" styleID="47" fgColor="569CD6" />

            <WordsStyle name="LIGHT-STRING-ESCAPE" styleID="48" fgColor="EE0000" />
            <WordsStyle name="DARK-STRING-ESCAPE" styleID="49" fgColor="D7BA7D" />

            <WordsStyle name="LIGHT-VARIABLE-ASSIGNMENT" styleID="50" fgColor="001080" />
            <WordsStyle name="DARK-VARIABLE-ASSIGNMENT" styleID="51" fgColor="9CDCFE" />
        </LexerType>
    </LexerStyles>
    <RAScript version="_GRAMMAR_VERSION_">
        <Include ref="#statements" />
        <Repository>
            <Rule name="statements">
                <!-- header before comments, since both start with // -->
                <Include ref="#header" />
                <Include ref="#comments" />
                <Include ref="#controls" />
                <Include ref="#booleans" />
                <Include ref="#strings" />
                <Include ref="#numbers" />
                <Include ref="#class-definitions" />
                <Include ref="#variable-language-this" />
            </Rule>
            <Rule name="header">
                <Rule match="^//[\t ]*(#ID)[\t ]*=[\t ]*(\d+)$" lightStyle="25" darkStyle="26">
                    <Capture index="1" lightStyle="29" darkStyle="30" />
                    <Capture index="2" lightStyle="40" darkStyle="41" />
                </Rule>
                <!-- only the RATools release versions listed in https://github.com/Jamiras/RATools/blob/master/Source/Data/Version.cs (0.73-0.79, 1.0-1.4, 1.3.1, 1.4.1, 1.4.2), optionally padded with .0 up to the 4 parts RATools parses (1.0.0.0 is 1.0). -->
                <Rule match="^//[\t ]*(#MinimumVersion)[\t ]*=[\t ]*((?:0\.7[3-9]|1\.[0-4])(?:\.0){0,2}|(?:1\.3\.1|1\.4\.[12])(?:\.0)?)$" lightStyle="25" darkStyle="26">
                    <Capture index="1" lightStyle="42" darkStyle="43" />
                    <Capture index="2" lightStyle="44" darkStyle="45" />
                </Rule>
            </Rule>
            <Rule name="comments">
                <Rule begin="/\*" end="\*/" lightStyle="27" darkStyle="28">
                    <Capture index="0" lightStyle="27" darkStyle="28" />
                </Rule>
                <Rule begin="//" end="$" lightStyle="25" darkStyle="26">
                    <BeginCapture index="0" lightStyle="25" darkStyle="26" />
                </Rule>
            </Rule>
            <Rule name="strings">
                <Rule begin='"' end='"' lightStyle="23" darkStyle="24">
                    <Rule match="\\u[0-9a-fA-F]{4}" lightStyle="48" darkStyle="49" />
                    <Rule match="\\." lightStyle="48" darkStyle="49" />
                    <Rule match="({)([0-9]+)(})">
                        <Capture index="1" lightStyle="46" darkStyle="47" />
                        <Capture index="2" lightStyle="1" darkStyle="2" />
                        <Capture index="3" lightStyle="46" darkStyle="47" />
                    </Rule>
                </Rule>
            </Rule>
            <Rule name="controls">
                <!-- if with its condition in parentheses: the condition is its own region so if (x) { isn't read as the lambda (x) { ... } -->
                <Rule begin="\b(if)[\t ]*\(" end="\)">
                    <BeginCapture index="1" lightStyle="3" darkStyle="4" />
                    <Include ref="$self" />
                </Rule>
                <!-- for loop header: in is only a keyword after for and the loop variable, elsewhere it is a normal name (in = 1, function in(...)) -->
                <Rule match="\b(for)[\t ]+(\b(?!\d)\w+)[\t ]+(in)\b">
                    <Capture index="1" lightStyle="3" darkStyle="4" />
                    <Capture index="2" lightStyle="1" darkStyle="2" />
                    <Capture index="3" lightStyle="3" darkStyle="4" />
                </Rule>
                <Rule match="\b(if|else|for|return)\b" lightStyle="3" darkStyle="4" />
            </Rule>
            <Rule name="booleans" match="\b(?:true|false)\b" lightStyle="7" darkStyle="8" />
            <Rule name="numbers">
                <!-- whole numbers and decimals like 19.25, scoped as one number including the dot -->
                <Rule match="\b[0-9]+(\.[0-9]+)?\b" lightStyle="9" darkStyle="10" />
                <Rule match="\b0x[0-9a-fA-F]+\b" lightStyle="11" darkStyle="12" />
            </Rule>
            <Rule name="class-definitions" match="(\bclass\b)[\t ]*(\b(?!\d)\w+)">
                <Capture index="1" lightStyle="13" darkStyle="14" />
                <Capture index="2" lightStyle="15" darkStyle="16" />
            </Rule>
            <Rule name="variable-language-this" match="\bthis\b" lightStyle="5" darkStyle="6" />
        </Repository>
        <Token name="Variables" type="NORMAL" regex="\b(?!\d)(\w+)" lightStyle="1" darkStyle="2" />
        <Token name="Variable Assignments" type="NORMAL" regex="\b(?!\d)(\w+)[\t ]*=(?![=>])" lightStyle="50" darkStyle="51" />
        <Token name="Function" type="NORMAL" regex="(\bfunction\b)[\t ]*[a-zA-Z_][\w]*[\t ]*\(" lightStyle="17" darkStyle="18" />
        <Token name="Function Calls" type="NORMAL" regex="\b(?!(?:if|else|for|return|this|true|false)\b)([a-zA-Z_][\w]*)[\t ]*\(" lightStyle="19" darkStyle="20" />
        <Token name="Function Names" type="NORMAL" regex="\bfunction\b[\t ]*([a-zA-Z_][\w]*)[\t ]*\(" lightStyle="21" darkStyle="22" />
    </RAScript>
</NotepadPlus>