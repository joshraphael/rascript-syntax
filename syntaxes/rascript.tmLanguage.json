{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "version": "_GRAMMAR_VERSION_",
    "name": "RAScript",
    "patterns": [
        {
            "include": "#statements"
        }
    ],
    "repository": {
        "statements": {
            "patterns": [
                {
                    "include": "#controls"
                },
                {
                    "include": "#function-definitions"
                },
                {
                    "include": "#booleans"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#function-names"
                },
                {
                    "include": "#class-definitions"
                },
                {
                    "include": "#header"
                },
                {
                    "include": "#comments"
                },
                {
                    "include": "#variable-language-this"
                },
                {
                    "include": "#variable-assignment"
                },
                {
                    "include": "#variable-other"
                }
            ]
        },
        "controls": {
            "patterns": [
                {
                    "name": "keyword.control.rascript",
                    "match": "\\b(if|else|for|in|return)\\b"
                }
            ]
        },
        "booleans": {
            "patterns": [{
                "name": "constant.language.boolean.rascript",
                "match": "\\b(true|false)\\b"
            }]
        },
        "strings": {
            "patterns": [
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.rascript",
                    "patterns": [
                        {
                            "match": "\\\\.",
                            "name": "constant.character.escape.rascript"
                        },
                        {
                            "match": "({)([0-9]+)(})",
                            "captures": {
                                "1": {
                                    "name": "punctuation.definition.template-expression.begin.rascript"
                                },
                                "2": {
                                    "name": "variable.other.rascript"
                                },
                                "3": {
                                    "name": "punctuation.definition.template-expression.end.rascript"
                                }
                            }
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.decimal.rascript",
                    "match": "\\b[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.hexadecimal.rascript",
                    "match": "(?i)\\$\\b\\h+\\b|\\b0x\\h+\\b"
                }
            ]
        },
        "function-definitions": {
            "comment": "force function keyword and function name with open parentheses on same line since this is a more complex capture. Go until functionsignature terminates (either { or =>)",
            "begin": "(\\bfunction\\b)\\s*(\\w+)\\s*\\(",
            "beginCaptures": {
                "1" : {
                    "name": "keyword.function.rascript"
                },
                "2": {
                    "name": "entity.name.function.rascript"
                }
            },
            "end": "\\{|\\=\\>",
            "patterns": [
                {
                    "include": "#inner-functions"
                },
                {
                    "include": "#booleans"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#function-names"
                },
                {
                    "comment": "if we detect an assignment, mark the left hand side a parameter",
                    "match": "(?<!\\=)\\s*(\\w+)\\s*(?=\\=)",
                    "captures": {
                        "1": {
                            "name": "variable.parameter.rascript"
                        }
                    }
                },
                {
                    "comment": "if the right hand side of the equals is NOT a function call, mark the word a variable",
                    "match": "(?<=\\=)\\s*(\\w+)\\s*(?!\\()",
                    "captures": {
                        "1": {
                            "name": "variable.other.rascript"
                        }
                    }
                },
                {
                    "comment": "mark everything else as a parameter",
                    "match": "\\w+",
                    "name": "variable.parameter.rascript"
                }
            ]
        },
        "function-names": {
            "patterns": [
                {
                    "match": "(\\b(byte|word|tbyte|dword|bit0|bit1|bit2|bit3|bit4|bit5|bit6|bit7|bit|low4|high4|bitcount|word_be|tbyte_be|dword_be|float|float_be|mbf32|mbf32_le|double32|double32_be|prev|prior|bcd|identity_transform|ascii_string_equals|unicode_string_equals|remembered|repeated|once|tally|deduct|never|unless|measured|trigger_when|disable_when|always_true|always_false|format|substring|length|range|array_push|array_pop|array_map|array_contains|array_reduce|array_filter|field_map|dictionary_contains_key|any_of|all_of|none_of|sum_of|tally_of|max_of|assert|achievement|rich_presence_display|rich_presence_value|rich_presence_lookup|rich_presence_ascii_string_lookup|rich_presence_macro|rich_presence_conditional_display|leaderboard|__ornext)\\b|(\\w+))\\s*(?=\\()",
                    "captures": {
                        "2": {
                            "name": "support.function.rascript"
                        },
                        "3": {
                            "name": "entity.name.function.rascript"
                        }
                    }
                }
            ]
        },
        "inner-functions": {
            "comment": "this prevents the function argument parser section to ignore inner function variables being marked as parameters by just passing them over",
            "begin": "\\(",
            "end": "\\)",
            "patterns": [
                {
                    "include": "$self"
                }
            ]
        },
        "class-definitions": {
            "patterns": [
                {
                    "match": "(\\bclass\\b)[\\t ]*([a-zA-Z_][\\w]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.class.rascript"
                        },
                        "2": {
                            "name": "entity.name.class.rascript"
                        }
                    }
                }
            ]
        },
        "header": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.rascript",
                    "match": "^//[\\t ]*(#ID)[\\t ]*=[\\t ]*(\\d+)$",
                    "captures": {
                        "1": {
                            "name": "keyword.other.id.rascript"
                        },
                        "2": {
                            "name": "constant.numeric.id.rascript"
                        }
                    }
                },
                {
                    "name": "comment.line.double-slash.rascript",
                    "match": "^//[\\t ]*(#MinimumVersion)[\\t ]*=[\\t ]*(\\d+(\\.\\d)?)$",
                    "captures": {
                        "1": {
                            "name": "keyword.other.version.rascript"
                        },
                        "2": {
                            "name": "constant.numeric.version.rascript"
                        }
                    }
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "begin": "/\\*",
                    "captures": {
                        "0": {
                            "name": "punctuation.definition.comment.block.rascript"
                        }
                    },
                    "end": "\\*/",
                    "name": "comment.block.rascript"
                },
                {
                    "begin": "//",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.single.rascript"
                        }
                    },
                    "end": "$",
                    "name": "comment.line.double-slash.rascript"
                }
            ]
        },
        "variable-language-this": {
            "patterns": [
                {
                    "name": "variable.language.this.rascript",
                    "match": "\\b(this)\\b"
                }
            ]
        },
        "variable-assignment": {
            "patterns": [
                {
                    "comment": "left hand side of variable assignment",
                    "match": "([a-zA-Z_][\\w]*)[\\t ]*=",
                    "captures": {
                        "1": {
                            "name": "variable.other.assignment.rascript"
                        }
                    }
                }
            ]
        },
        "variable-other": {
            "patterns": [
                {
                    "comment": "different variables around the file being used, not assignment",
                    "match": "([a-zA-Z_][\\w]*)",
                    "captures": {
                        "1": {
                            "name": "variable.other.rascript"
                        }
                    }
                }
            ]
        }
    },
    
    "scopeName": "source.rascript"
}